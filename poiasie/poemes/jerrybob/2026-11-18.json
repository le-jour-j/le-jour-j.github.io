{"jour":"2026-11-18","machine":"jerrybob","poemes":[{"id":"20261118-010031-jerrybob","date":"2026-11-18T01:00:31","machine":"jerrybob","forme":"vers_libres","forme_nom":"Vers libres","titre":"Perte de valeur, désespoir","titre_par":"Le malaxeur","epigraphe":{"texte":"La pluie d’octobre, probable","poete":"Le lyrique"},"strophes":[{"poete":"Le malaxeur","role":"ouverture","mot_impose":"émettre","vers":[{"texte":"Le parapluie s'ouvre sur le verbe aérer.","syllabes":11},{"texte":"Une lampe de poche trace le cerisier.","syllabes":13},{"texte":"L'argent s'infiltre dans la décharge.","syllabes":9}]},{"poete":"L'exorciste","role":"voix 2","mot_impose":"payer pour les autres","vers":[{"texte":"Le bureau de tabac fume.","syllabes":7},{"texte":"Le citron se fend, acide et lent.","syllabes":9},{"texte":"Il vide l'abat-jour.","syllabes":6}]},{"poete":"Le mode d'emploi","role":"voix 3","mot_impose":"récompenser","vers":[{"texte":"L’abat-jour se déchire, un silence de plomb.","syllabes":12},{"texte":"Le vin rouge coule, acide sur le tabouret.","syllabes":13},{"texte":"La récompense glisse, une pierre dans l’eau.","syllabes":12}]},{"poete":"Le nomenclateur","role":"voix 4","mot_impose":"devoir une fière chandelle","vers":[{"texte":"L’Homme Escompté se frotte le nez sur le tabouret.","syllabes":14},{"texte":"Une pierre dans l’eau, la récompense, et le dé à coudre.","syllabes":15}]},{"poete":"Le chosiste","role":"voix 5","mot_impose":"arbitragiste","vers":[{"texte":"coudre l’air de la sacristie sombre et humide.","syllabes":12},{"texte":"le sablier déverse des grains de silence pâle.","syllabes":14},{"texte":"la passoire garde une trace de sel oublié.","syllabes":14}]}]}]}