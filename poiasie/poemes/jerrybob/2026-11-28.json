{"jour":"2026-11-28","machine":"jerrybob","poemes":[{"id":"20261128-010034-jerrybob","date":"2026-11-28T01:00:34","machine":"jerrybob","forme":"rondeau","forme_nom":"Rondeau","titre":"Édouard, comprendre l’espace","titre_par":"Le minimaliste","memo":{"rentrement":"L’ombre d’un observatoire"},"epigraphe":{"texte":"Coins d'or dormants sous les yeux sourds.","poete":"Le surréaliste"},"strophes":[{"poete":"Le débit","role":"le premier quintil","mot_impose":"profitabilité","vers":[{"texte":"L’ombre d’un observatoire se déplace lentement.","lettre":"A","syllabes":15},{"texte":"Le vent s’échappe, un tablier de craie s’effrite.","lettre":"A","syllabes":12},{"texte":"Des pépètes s’écoulent, un temps oublié s’est créé.","lettre":"B","syllabes":14},{"texte":"Le cuivre se rouille, un secret dans le bois étiré.","lettre":"B","syllabes":14},{"texte":"L’absence résonne, comme l’horloge dans le buffet.","lettre":"A","syllabes":15}]},{"poete":"L'inventoriste","role":"le tercet","mot_impose":"keynésien","vers":[{"texte":"Le gobelet brisé, l’argent qui s’éteint.","lettre":"A","syllabes":11},{"texte":"L’ombre d’un observatoire, il sentait l’hésitation.","lettre":"A","syllabes":14},{"texte":"La solvabilité usée, un étiré des doigts.","lettre":"B","syllabes":14},{"texte":"L’ombre d’un observatoire","syllabes":7,"herite":true,"refrain":"R"}]},{"poete":"Le minimaliste","role":"le dernier quintil","mot_impose":"partage des biens","vers":[{"texte":"Le temps des dessins oubliés, crayons","lettre":"A","syllabes":10},{"texte":"La bourse et sa lourde stipulation","lettre":"A","syllabes":10},{"texte":"Il pressera le papier préfera","lettre":"B","syllabes":10},{"texte":"Les mots d’une porte chantera","lettre":"B","syllabes":9},{"texte":"Une fine cloison s'étire","lettre":"A","syllabes":8},{"texte":"L’ombre d’un observatoire","syllabes":7,"herite":true,"refrain":"R"}]}]}]}